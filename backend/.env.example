# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voicedin
MIGRATION_REQUIRED_VERSION=009_enable_rls_on_hardening_tables.sql

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
ALLOW_DEBUG_RESET_TOKENS=false

# Google OAuth
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET is not needed for the current frontend ID-token login flow.
# Only add it for a future server-side OAuth redirect flow.
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Static Premium Payment QR
PREMIUM_PAYMENT_AMOUNT=49
PREMIUM_PAYMENT_UPI_ID=shaahir2007@okhdfcbank
PREMIUM_PAYMENT_PHONE=7904515049
PREMIUM_PAYMENT_PAYEE_NAME=Your Name
PREMIUM_PAYMENT_QR_URL=/my-payment-qr.jpeg
PREMIUM_PAYMENT_NOTE=Send payment screenshot after scanning the QR. Premium is activated after confirmation.

# Godmode admin approval
GODMODE_ADMIN_KEY=change-this-admin-key

# Frontend URL(s) for CORS. Use comma-separated values if you need local + deployed.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,https://voicedin2.onrender.com,https://voicedin.lat,https://www.voicedin.lat
API_PUBLIC_URL=https://voicedin.onrender.com

# Legacy local upload directory used as a fallback when Supabase Storage is not configured.
UPLOAD_DIR=uploads

# Supabase Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_PUBLIC_BUCKET=public-assets
SUPABASE_STORAGE_PRIVATE_BUCKET=private-assets

# Optional: set this if Puppeteer needs an explicit browser path
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional: Render/Linux browser cache used by Puppeteer
# PUPPETEER_CACHE_DIR=.cache/puppeteer
